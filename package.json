{
    "name": "portfolio",
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "dev": "astro dev",
        "start": "astro dev",
        "host": "astro dev --host",
        "build": "astro check && astro build",
        "preview": "astro preview",
        "astro": "astro",
        "format": "prettier --tab-width 4 --print-width 80 --no-semi --single-quote --trailing-comma es5 --write .",
        "dev:api": "wrangler d1 migrations apply DB --local && wrangler dev --port 8787",
        "db:migrate": "wrangler d1 migrations apply DB --remote",
        "check:worker": "tsc -p worker/tsconfig.json"
    },
    "dependencies": {
        "@astrojs/check": "^0.9.10",
        "@astrojs/react": "^7.0.0",
        "@emailjs/browser": "^4.4.1",
        "@react-three/fiber": "^8.17.10",
        "@tailwindcss/vite": "^4.3.3",
        "@types/react": "^18.2.79",
        "@types/react-dom": "^18.2.25",
        "astro": "^7.3.5",
        "lucide-react": "^0.468.0",
        "marked": "^15.0.6",
        "pixelarticons": "^2.1.2",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-swipeable": "^7.0.1",
        "sonner": "^2.0.6",
        "tailwindcss": "^4.3.3",
        "three": "^0.171.0",
        "typescript": "^5.4.2"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261005.1",
        "@types/three": "^0.171.0",
        "eslint-config-prettier": "^9.1.0",
        "prettier": "3.4.2",
        "prettier-plugin-astro": "^0.14.1",
        "wrangler": "^4.147.0"
    }
}
