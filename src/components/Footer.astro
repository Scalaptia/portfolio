---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "@/i18n/utils";
import { languages } from "@/i18n/ui";

export interface FooterProps {
  hideLanguagePicker?: boolean;
}
const { hideLanguagePicker } = Astro.props;

const currentPath = Astro.url;
const lang = getLangFromUrl(currentPath);
const translatePath = useTranslatedPath(lang);
---

<footer class="flex flex-col items-center gap-2 mt-auto">
  <div class="text-lg text-center text-primary font-ubuntu-mono">
    <a href="/">&copy; {new Date().getFullYear()} Fernando Haro Calvo</a>
  </div>
  <!-- The way in for anyone who does not know the Konami code. -->
  <button
    type="button"
    data-harogatos="desktop"
    class="group mb-4 font-ubuntu-mono text-sm text-text/45 hover:text-primary transition-colors duration-150"
    aria-label="Open harogatOS"
  >
    C:\&gt; harogatOS<span class="inline-block w-[0.55em] h-[1em] align-middle ml-0.5 bg-current crt-led"></span>
  </button>
</footer>
