---
import { getLangFromUrl } from "@/i18n/utils";
import { getI18N } from "@/i18n/index";
import VideoPlayer from "@/components/VideoPlayer.astro";
import { MediaGallery } from "@/components/MediaGallery";
import PixelIcon from "@/components/PixelIcon";
import { getProjectDetail } from "@/data/projectDetails";

const { slug } = Astro.props;
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
const lang = getLangFromUrl(Astro.url);

const detail = getProjectDetail(slug, lang);

const project = i18n.PROJECTS.find((p) => p.slug === slug);

if (!detail || !project) {
  Astro.response.status = 404;
}
---

{
  !detail || !project ? (
    <div class="flex flex-col items-center justify-center min-h-[50vh] gap-4">
      <h1 class="text-3xl font-black-han-sans text-text">{i18n.TEXT_404}</h1>
      <a href="/" class="text-primary font-ubuntu-mono hover:underline hover:text-text transition-colors duration-150">&larr; Home</a>
    </div>
  ) : (
    <div class="px-4 sm:px-6 lg:px-8 flex flex-col w-full items-center max-w-[600px] lg:max-w-[900px] gap-10 my-8 lg:my-12">
      <div class="w-full">
        <a
          href={lang === "es" ? "/es/#projects" : "/#projects"}
          class="inline-flex items-center gap-2 text-primary font-ubuntu-mono text-sm hover:underline hover:text-text transition-colors duration-150 mb-8"
        >
          <PixelIcon name="arrow-left" className="w-4 h-4" />
          {i18n.TAG_PROJECTS}
        </a>

        <h1 class="text-3xl sm:text-4xl font-black-han-sans text-text mb-3">
          {project.title}
        </h1>
        <p class="text-text/70 font-open-sans text-lg leading-relaxed">
          {project.description}
        </p>

        {project.context && (
          <span class="inline-block mt-3 text-text/60 font-ubuntu-mono text-xs font-semibold px-3 py-1 border-2 border-text/30 bg-primary/10">
            {project.context}
          </span>
        )}
      </div>

      <!-- Images -->
      <div class="w-full">
        <MediaGallery
          client:visible
          items={project.image.map((src) => ({ type: "image" as const, src, lightboxSrc: src.includes('/stilo-') ? src.replace('.png', '-cropped.png') : undefined }))}
          mode="grid"
        />
      </div>

      <div class="w-full bg-background/80 backdrop-blur-sm border-2 sm:border-4 border-text shadow-[4px_4px_0px_0px_rgba(65,44,71,1)] sm:shadow-[8px_8px_0px_0px_rgba(65,44,71,1)] p-6 sm:p-8 relative">
        <div class="absolute top-0 left-0 w-6 h-6 border-r-4 border-b-4 border-text/30"></div>
        <div class="absolute bottom-0 right-0 w-6 h-6 border-l-4 border-t-4 border-text/30"></div>
        <div class="relative z-10">
          <h2 class="text-lg sm:text-xl font-ubuntu-mono font-bold text-primary uppercase tracking-wide mb-4">
            {i18n.TEXT_THE_PROBLEM}
          </h2>
          <p class="text-text font-open-sans text-base sm:text-lg leading-relaxed">
            {detail.problem}
          </p>
        </div>
      </div>

      <div class="w-full bg-background/80 backdrop-blur-sm border-2 sm:border-4 border-text shadow-[4px_4px_0px_0px_rgba(65,44,71,1)] sm:shadow-[8px_8px_0px_0px_rgba(65,44,71,1)] p-6 sm:p-8 relative">
        <div class="absolute top-0 left-0 w-6 h-6 border-r-4 border-b-4 border-text/30"></div>
        <div class="absolute bottom-0 right-0 w-6 h-6 border-l-4 border-t-4 border-text/30"></div>
        <div class="relative z-10">
          <h2 class="text-lg sm:text-xl font-ubuntu-mono font-bold text-primary uppercase tracking-wide mb-4">
            {i18n.TEXT_HOW_IT_WORKS}
          </h2>
          <ol class="space-y-4">
            {detail.howItWorks.map((step, i) => (
              <li class="flex gap-4 text-text font-open-sans text-base sm:text-lg leading-relaxed">
                <span class="flex-shrink-0 w-7 h-7 bg-primary border-2 border-text flex items-center justify-center text-background font-ubuntu-mono font-bold text-sm">
                  {i + 1}
                </span>
                <span class="pt-0.5">{step}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <div class="w-full bg-background/80 backdrop-blur-sm border-2 sm:border-4 border-text shadow-[4px_4px_0px_0px_rgba(65,44,71,1)] sm:shadow-[8px_8px_0px_0px_rgba(65,44,71,1)] p-6 sm:p-8 relative">
        <div class="absolute top-0 left-0 w-6 h-6 border-r-4 border-b-4 border-text/30"></div>
        <div class="absolute bottom-0 right-0 w-6 h-6 border-l-4 border-t-4 border-text/30"></div>
        <div class="relative z-10">
          <h2 class="text-lg sm:text-xl font-ubuntu-mono font-bold text-primary uppercase tracking-wide mb-4">
            {i18n.TEXT_WHAT_I_BUILT}
          </h2>
          <div class="space-y-4">
            {detail.whatIBuilt.map((item) => (
              <div class="flex gap-3">
                <span class="flex-shrink-0 w-2 h-2 bg-primary border border-text rotate-45 mt-2.5"></span>
                <p class="text-text font-open-sans text-base sm:text-lg leading-relaxed">
                  {item}
                </p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="w-full bg-background/80 backdrop-blur-sm border-2 sm:border-4 border-text shadow-[4px_4px_0px_0px_rgba(65,44,71,1)] sm:shadow-[8px_8px_0px_0px_rgba(65,44,71,1)] p-6 sm:p-8 relative">
        <div class="absolute top-0 left-0 w-6 h-6 border-r-4 border-b-4 border-text/30"></div>
        <div class="absolute bottom-0 right-0 w-6 h-6 border-l-4 border-t-4 border-text/30"></div>
        <div class="relative z-10">
          <h2 class="text-lg sm:text-xl font-ubuntu-mono font-bold text-primary uppercase tracking-wide mb-4">
            {i18n.TEXT_RESULTS}
          </h2>
          <p class="text-text font-open-sans text-base sm:text-lg leading-relaxed">
            {detail.results}
          </p>
        </div>
      </div>

      {
        detail.videoUrl && (
          <div class="w-full">
            <VideoPlayer url={detail.videoUrl} />
          </div>
        )
      }

      {
        project.tags && (
          <div class="w-full">
            <h2 class="text-lg sm:text-xl font-ubuntu-mono font-bold text-primary uppercase tracking-wide mb-3">
              {i18n.TEXT_TECHNOLOGIES}
            </h2>
            <div class="flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span class="text-white bg-text border-2 border-white px-3 py-1 text-sm font-ubuntu-mono font-extrabold shadow-[2px_2px_0px_0px_rgba(253,141,117,0.6)] transition-all duration-150 hover:shadow-[3px_3px_0px_0px_rgba(253,141,117,0.8)] hover:-translate-x-[1px] hover:-translate-y-[1px] cursor-default">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        )
      }
    </div>
  )
}
