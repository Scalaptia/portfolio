---
import LinkButton from "@/components/LinkButton.astro";
import ProjectsGrid from "@/components/ProjectsGrid";
import OtherProjects from "@/components/OtherProjects.astro";
import MoreAbout from "@/components/MoreAbout.astro";
import Highlights from "@/components/Highlights.astro";
import Experience from "@/components/Experience";
import PixelIcon from "@/components/PixelIcon";
import CopyToClipboard from "@/components/CopyButton";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { getI18N } from "@/i18n/index";
import { parseMarkdown } from "@/utils/markdown";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<main>
  <!-- Hero section -->
  <div
    slot="content"
    class="relative flex flex-col lg:flex-row lg:items-center lg:justify-between max-w-[600px] lg:max-w-[1000px] mb-16 lg:mb-24 pt-8 lg:pt-16 px-4 sm:px-6 lg:px-8"
  >
    <!-- Left: Name + Description + Links -->
    <div class="flex flex-col w-full lg:flex-1 lg:pr-10 relative z-10">
      <h1
        class="text-5xl sm:text-6xl font-black-han-sans text-text leading-[1.1em] text-center lg:text-left drop-shadow-sm group cursor-pointer hover:scale-[1.02] transition-transform duration-300 origin-center lg:origin-left"
      >
        <span
          id="hero-name-1"
          class="hero-name inline-block group-hover:text-primary transition-colors duration-300 select-none"
          >Fernando</span
        >
        <span
          id="hero-name-2"
          class="hero-name inline-block group-hover:text-primary transition-colors duration-300 select-none"
          >Haro</span
        >
      </h1>

      <p
        class="mt-4 text-lg sm:text-xl font-open-sans text-text leading-[1.5em] text-center lg:text-left"
        set:html={parseMarkdown(i18n.TEXT_DESCRIPTION_1)}
      />

      <!-- Links -->
      <div class="mt-8 w-full max-w-[600px] lg:max-w-none mx-auto lg:mx-0">
        <div class="grid grid-cols-1 sm:grid-cols-3 w-full gap-4">
          <LinkButton
            link="https://www.github.com/Scalaptia"
            text="GitHub"
            icon="github"
          />
          <LinkButton
            link="https://www.linkedin.com/in/haro-fernando/"
            text="LinkedIn"
            icon="linkedin"
          />
          <LinkButton
            link="/Resume_Fernando_Haro.pdf"
            text="Resume"
            icon="download"
          />
        </div>

        <div
          class="mt-4 flex bg-white text-text px-3 sm:px-6 py-3 sm:py-4 gap-2 sm:gap-4 justify-between items-center border-2 sm:border-4 border-text shadow-[2px_2px_0px_0px_rgba(65,44,71,1)] sm:shadow-[4px_4px_0px_0px_rgba(65,44,71,1)] min-w-0 w-full hover:shadow-[3px_3px_0px_0px_rgba(65,44,71,1)] sm:hover:shadow-[6px_6px_0px_0px_rgba(65,44,71,1)] hover:translate-x-[-2px] hover:translate-y-[-2px] transition-all duration-200"
        >
          <span
            class="font-open-sans font-semibold pt-[1px] text-xs sm:text-sm lg:text-base truncate flex-1 min-w-0"
            >fernando.haro.c@gmail.com</span
          >

          <div class="flex gap-2 sm:gap-4 flex-shrink-0">
            <a
              href="mailto:fernando.haro.c@gmail.com"
              class="flex transition-all duration-150 hover:scale-110 hover:text-primary"
            >
              <PixelIcon name="send" className="w-5 h-5" />
            </a>

            <CopyToClipboard
              client:visible
              text="fernando.haro.c@gmail.com"
              copiedText={i18n.TEXT_COPIED}
            />
          </div>
        </div>
      </div>
    </div>

    <!-- The PC itself lives in the layout so it survives navigation. This holds its place. -->
    <div
      id="pc-hero-anchor"
      class="relative w-[200px] h-[200px] mx-auto mt-10 lg:mx-0 lg:w-[240px] lg:h-[240px] lg:flex-shrink-0 lg:-mt-8"
    >
      <div id="click-me-text" class="absolute -bottom-4 left-1/2 -translate-x-1/2 text-center pointer-events-none transition-opacity duration-300">
        <p class="text-text/50 text-xs font-ubuntu-mono">
          {i18n.CLICK_ME || "Click me!"}
        </p>
      </div>
    </div>
  </div>

  <!-- Experience -->
  <div
    id="experience"
    slot="content"
    class="px-4 sm:px-6 lg:px-8 flex flex-col w-full items-center lg:flex-row lg:flex-wrap lg:justify-between max-w-[600px] lg:max-w-[1000px] lg:gap-y-8 mt-16 lg:mt-24 relative"
  >
    <span
      class="text-primary text-start font-ubuntu-mono text-2xl self-start w-full mb-6 relative z-10"
      >&lt;{i18n.TAG_EXPERIENCE}&gt;</span
    >
    <Experience experiences={i18n.EXPERIENCE} client:visible />
    <span
      class="text-primary font-ubuntu-mono text-2xl text-end w-full lg:text-end self-end mt-4 relative z-10"
      >&lt;/{i18n.TAG_EXPERIENCE}&gt;</span
    >
  </div>

  <!-- Projects -->
  <div
    id="projects"
    slot="content"
    class="px-4 sm:px-6 lg:px-8 flex flex-col w-full items-center lg:flex-row lg:flex-wrap lg:justify-between max-w-[600px] lg:max-w-[1000px] lg:gap-y-8 mt-16 lg:mt-24 relative"
  >
    <span
      class="text-primary text-start font-ubuntu-mono text-2xl self-start w-full mb-6 relative z-10"
      >&lt;{i18n.TAG_PROJECTS}&gt;</span
    >
    <ProjectsGrid
      projects={i18n.PROJECTS}
      translations={{
        keyContributions: i18n.TEXT_KEY_CONTRIBUTIONS,
        technologies: i18n.TEXT_TECHNOLOGIES,
        swipeHint: i18n.TEXT_SWIPE_HINT,
        readMore: i18n.TEXT_READ_MORE,
      }}
      locale={lang}
      client:visible
    />
    <!-- Other Projects -->
    {i18n.OTHER_PROJECTS && i18n.OTHER_PROJECTS.length > 0 && (
      <div class="w-full mt-8 lg:mt-10 reveal">
        <OtherProjects
          projects={i18n.OTHER_PROJECTS}
          heading={i18n.TEXT_OTHER_PROJECTS}
        />
      </div>
    )}

    <span
      class="text-primary font-ubuntu-mono text-2xl text-end w-full lg:text-end self-end mt-4 relative z-10"
      >&lt;/{i18n.TAG_PROJECTS}&gt;</span
    >
  </div>

  <!-- Highlights -->
  <div
    id="events"
    slot="content"
    class="px-4 sm:px-6 lg:px-8 flex flex-col w-full items-center lg:flex-row lg:flex-wrap lg:justify-between max-w-[600px] lg:max-w-[1000px] mt-16 lg:mt-24 relative"
  >
    <span
      class="text-primary text-start font-ubuntu-mono text-2xl self-start w-full mb-6 relative z-10"
      >&lt;{i18n.TEXT_HIGHLIGHTS}&gt;</span
    >
    <Highlights highlights={i18n.HIGHLIGHTS} />
    <span
      class="text-primary font-ubuntu-mono text-2xl text-end w-full lg:text-end self-end mt-4 relative z-10"
      >&lt;/{i18n.TEXT_HIGHLIGHTS}&gt;</span
    >
  </div>

  <!-- About Me -->
  <div
    id="about"
    slot="content"
    class="px-4 sm:px-6 lg:px-8 flex flex-col w-full items-center lg:flex-row lg:flex-wrap lg:justify-between max-w-[600px] lg:max-w-[1000px] mt-16 lg:mt-24 mb-16 lg:mb-24 relative"
  >
    <span
      class="text-primary text-start font-ubuntu-mono text-2xl self-start w-full mb-6 relative z-10"
      >&lt;{i18n.TAG_ABOUT_ME}&gt;</span
    >
    <MoreAbout />
    <span
      class="text-primary font-ubuntu-mono text-2xl text-end w-full lg:text-end self-end mt-4 relative z-10"
      >&lt;/{i18n.TAG_ABOUT_ME}&gt;</span
    >
  </div>
</main>

<script>
  const heroNames = document.querySelectorAll('.hero-name');

  heroNames.forEach(name => {
    name.addEventListener('mouseenter', () => {
      window.dispatchEvent(new CustomEvent('heroHover', { detail: { hovered: true } }));
    });

    name.addEventListener('mouseleave', () => {
      window.dispatchEvent(new CustomEvent('heroHover', { detail: { hovered: false } }));
    });
  });

  document.addEventListener('DOMContentLoaded', () => {
    const projectCards = document.querySelectorAll('[data-pc-reacts]');
    projectCards.forEach(card => {
      card.addEventListener('mouseenter', () => {
        window.dispatchEvent(new CustomEvent('pageInteraction', { detail: { type: 'project', hovered: true } }));
      });
      card.addEventListener('mouseleave', () => {
        window.dispatchEvent(new CustomEvent('pageInteraction', { detail: { type: 'project', hovered: false } }));
      });
    });

    const socialLinks = document.querySelectorAll('a[href*="github"], a[href*="linkedin"]');
    socialLinks.forEach(link => {
      link.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('pageInteraction', { detail: { type: 'social' } }));
      });
    });

    window.addEventListener('emailCopied', () => {
      window.dispatchEvent(new CustomEvent('pageInteraction', { detail: { type: 'email' } }));
    });
  });
</script>
