---
import { getLangFromUrl } from "@/i18n/utils";
import { getI18N } from "@/i18n/index";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
const lang = getLangFromUrl(Astro.url);
const base = lang === "en" ? "/" : "/es/";
---

<header
  class="fixed top-0 left-0 right-0 z-50 bg-background/95 backdrop-blur-md border-b-2 sm:border-b-4 border-text shadow-[0_2px_0px_0px_rgba(65,44,71,1)] sm:shadow-[0_4px_0px_0px_rgba(65,44,71,1)]"
>
  <nav class="max-w-6xl mx-auto px-3 sm:px-6 py-2 sm:py-4">
    <div class="flex items-center justify-between">
      <!-- Left: Hamburger (mobile) + Logo -->
      <div class="flex items-center gap-2 sm:gap-3 min-w-0">
        <!-- Simple Mobile Menu Button -->
        <button
          id="mobile-menu-button"
          class="lg:hidden p-1 sm:p-2 text-text hover:text-primary transition-colors duration-200 flex items-center justify-center flex-shrink-0"
          aria-label="Toggle menu"
        >
          <svg
            class="w-5 h-5 sm:w-6 sm:h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>

        <a
          href={base}
          class="text-lg sm:text-xl lg:text-2xl font-black-han-sans text-text hover:text-primary transition-colors duration-200 truncate leading-none flex items-center pt-0.5"
        >
          Fernando Haro
        </a>
      </div>

      <!-- Desktop Navigation Links -->
      <div class="hidden lg:flex items-center gap-6">
        <a
          href={`${base}#experience`}
          class="text-text hover:text-primary transition-colors duration-200 font-ubuntu-mono font-semibold text-lg border-b-2 border-transparent hover:border-primary pb-1 leading-none flex items-center"
        >
          {i18n.TAG_EXPERIENCE}
        </a>
        <a
          href={`${base}#projects`}
          class="text-text hover:text-primary transition-colors duration-200 font-ubuntu-mono font-semibold text-lg border-b-2 border-transparent hover:border-primary pb-1 leading-none flex items-center"
        >
          {i18n.TAG_PROJECTS}
        </a>
        <a
          href={`${base}#events`}
          class="text-text hover:text-primary transition-colors duration-200 font-ubuntu-mono font-semibold text-lg border-b-2 border-transparent hover:border-primary pb-1 leading-none flex items-center"
        >
          {i18n.TEXT_HIGHLIGHTS}
        </a>
        <a
          href={`${base}#about`}
          class="text-text hover:text-primary transition-colors duration-200 font-ubuntu-mono font-semibold text-lg border-b-2 border-transparent hover:border-primary pb-1 leading-none flex items-center"
        >
          {i18n.TAG_ABOUT_ME}
        </a>
      </div>

      <!-- Language Switcher -->
      <div class="flex items-center">
        <!-- Desktop -->
        <div class="hidden lg:flex items-center">
          <div
            class="flex items-center bg-white border-2 border-text shadow-[2px_2px_0px_0px_rgba(65,44,71,1)] overflow-hidden"
          >
            <a
              href="/"
              class={`px-4 py-2 font-ubuntu-mono font-semibold text-sm leading-none transition-all duration-200 flex items-center ${
                lang === "en"
                  ? "bg-primary text-white"
                  : "bg-white text-text hover:bg-primary/10"
              }`}
            >
              EN
            </a>
            <a
              href="/es/"
              class={`px-4 py-2 font-ubuntu-mono font-semibold text-sm leading-none transition-all duration-200 flex items-center ${
                lang === "es"
                  ? "bg-primary text-white"
                  : "bg-white text-text hover:bg-primary/10"
              }`}
            >
              ES
            </a>
          </div>
        </div>

        <!-- Mobile -->
        <div class="lg:hidden flex items-center">
          <div
            class="flex items-center bg-white border-2 border-text shadow-[1px_1px_0px_0px_rgba(65,44,71,1)] sm:shadow-[2px_2px_0px_0px_rgba(65,44,71,1)] overflow-hidden"
          >
            <a
              href="/"
              class={`px-2 sm:px-3 py-1 sm:py-1.5 font-ubuntu-mono font-semibold text-xs leading-none transition-all duration-200 flex items-center ${
                lang === "en"
                  ? "bg-primary text-white"
                  : "bg-white text-text hover:bg-primary/10"
              }`}
            >
              EN
            </a>
            <a
              href="/es/"
              class={`px-2 sm:px-3 py-1 sm:py-1.5 font-ubuntu-mono font-semibold text-xs leading-none transition-all duration-200 flex items-center ${
                lang === "es"
                  ? "bg-primary text-white"
                  : "bg-white text-text hover:bg-primary/10"
              }`}
            >
              ES
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="lg:hidden hidden mt-4 pb-4 border-t-2 border-text/20"
    >
      <div class="flex flex-col space-y-3 pt-4">
        <a
          href={`${base}#experience`}
          class="text-text hover:text-primary transition-colors duration-200 font-ubuntu-mono font-semibold text-base py-2 px-2 rounded hover:bg-primary/5"
        >
          {i18n.TAG_EXPERIENCE}
        </a>
        <a
          href={`${base}#projects`}
          class="text-text hover:text-primary transition-colors duration-200 font-ubuntu-mono font-semibold text-base py-2 px-2 rounded hover:bg-primary/5"
        >
          {i18n.TAG_PROJECTS}
        </a>
        <a
          href={`${base}#events`}
          class="text-text hover:text-primary transition-colors duration-200 font-ubuntu-mono font-semibold text-base py-2 px-2 rounded hover:bg-primary/5"
        >
          {i18n.TEXT_HIGHLIGHTS}
        </a>
        <a
          href={`${base}#about`}
          class="text-text hover:text-primary transition-colors duration-200 font-ubuntu-mono font-semibold text-base py-2 px-2 rounded hover:bg-primary/5"
        >
          {i18n.TAG_ABOUT_ME}
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const mobileMenuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");

  mobileMenuButton?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
  });

  document.querySelectorAll("#mobile-menu a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu?.classList.add("hidden");
    });
  });

  // Smooth scrolling for same-page anchor links
  document.querySelectorAll('a[href*="#"]').forEach((anchor) => {
    anchor.addEventListener("click", (e) => {
      const href = (anchor as HTMLAnchorElement).getAttribute("href");
      const hashIndex = href?.indexOf("#") ?? -1;
      if (hashIndex === -1) return;
      const hash = href!.slice(hashIndex);
      const target = document.querySelector(hash);
      if (!target) return;

      e.preventDefault();
      const header = document.querySelector("header");
      const headerHeight = header ? header.offsetHeight : 0;
      window.scrollTo({
        top: (target as HTMLElement).offsetTop - headerHeight - 20,
        behavior: "smooth",
      });
      mobileMenu?.classList.add("hidden");
    });
  });

  // Logo: scroll to top if on main page
  const logoLink = document.querySelector('a[href="/"], a[href="/es/"]');
  logoLink?.addEventListener("click", (e) => {
    const isMainPage = document.querySelector("#experience");
    if (isMainPage) {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  });

  // Active link state based on scroll position
  const sections = ["experience", "projects", "events", "about"];
  const navLinks = document.querySelectorAll('a[href*="#"]:not([href$="/"])');
  const logoLinkEl = logoLink;
  function updateActiveLink() {
    const header = document.querySelector("header");
    const headerHeight = header ? header.offsetHeight : 0;
    const scrollY = window.scrollY;
    const viewportCenter = scrollY + window.innerHeight / 2;
    let current = "";

    sections.forEach((sectionId) => {
      const section = document.querySelector(`#${sectionId}`);
      if (section) {
        const element = section as HTMLElement;
        const sectionTop = element.offsetTop;
        const sectionBottom = sectionTop + element.offsetHeight;

        if (viewportCenter >= sectionTop && viewportCenter <= sectionBottom) {
          current = sectionId;
        }
      }
    });

    const firstSection = document.querySelector("#experience");
    const isInHero =
      firstSection && viewportCenter < (firstSection as HTMLElement).offsetTop;

    navLinks.forEach((link) => {
      const href = link.getAttribute("href");
      const hashIndex = href?.indexOf("#") ?? -1;
      const hash = hashIndex !== -1 ? href!.slice(hashIndex) : "";
      if (hash === `#${current}`) {
        link.classList.add("text-primary", "border-primary");
        link.classList.remove("border-transparent");
      } else {
        link.classList.remove("text-primary", "border-primary");
        link.classList.add("border-transparent");
      }
    });

    if (logoLinkEl) {
      if (isInHero) {
        logoLinkEl.classList.add("text-primary");
        logoLinkEl.classList.remove("text-text");
      } else {
        logoLinkEl.classList.remove("text-primary");
        logoLinkEl.classList.add("text-text");
      }
    }
  }

  window.addEventListener("scroll", updateActiveLink);
  updateActiveLink();
</script>
