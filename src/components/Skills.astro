---
interface SkillGroup {
  label: string;
  items: string[];
}

export interface Props {
  groups: SkillGroup[];
}

const { groups } = Astro.props;
---

<div class="w-full grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
  {
    groups.map((group) => (
      <div class="bg-background/80 backdrop-blur-sm border-2 sm:border-4 border-text shadow-[4px_4px_0px_0px_rgba(65,44,71,1)] sm:shadow-[6px_6px_0px_0px_rgba(65,44,71,1)] p-4 sm:p-5 relative hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[6px_6px_0px_0px_rgba(65,44,71,1)] sm:hover:shadow-[8px_8px_0px_0px_rgba(65,44,71,1)] transition-all duration-200">
        <div class="absolute top-0 left-0 w-5 h-5 border-r-4 border-b-4 border-text/30" />

        <h3 class="font-ubuntu-mono text-primary text-sm font-bold uppercase tracking-wider mb-3 relative z-10">
          {group.label}
        </h3>

        <ul class="flex flex-wrap gap-1.5 relative z-10">
          {group.items.map((item) => (
            <li class="text-text font-ubuntu-mono text-xs sm:text-sm bg-text/5 border border-text/20 px-2 py-1">
              {item}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
