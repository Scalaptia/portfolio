---
import PixelIcon from '@/components/PixelIcon';

interface OtherProject {
  title: string;
  description: string;
  tags: string[];
  image?: string;
  /** Extra shots behind the card image. Falls back to the card image on its own. */
  gallery?: string[];
  /** A YouTube id. The trailer opens first, playing on the monitor. */
  trailer?: string;
  repo?: string;
}

export interface Props {
  projects: OtherProject[];
  heading: string;
}
const { projects, heading } = Astro.props;

// Each card opens its own pictures and nobody else's. A project with a gallery pages through it;
// one without pages through nothing, which is the whole set of one.
const setFor = (project: OtherProject) => {
  const shots = (project.gallery?.length ? project.gallery : [project.image!]).map((src) => ({
    type: 'image' as const,
    src,
    alt: project.title,
    caption: project.title,
  }));
  if (!project.trailer) return shots;
  return [
    { type: 'youtube' as const, src: project.trailer, alt: project.title, caption: project.title },
    ...shots,
  ];
};
---

<div class="w-full max-w-[600px] lg:max-w-[1000px]">
  <h3 class="text-primary font-ubuntu-mono text-lg font-bold uppercase tracking-wide mb-4">
    {heading}
  </h3>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full">
    {projects.map((project) => (
      <div class="bg-background/80 backdrop-blur-sm border-2 sm:border-4 border-text shadow-[4px_4px_0px_0px_rgba(65,44,71,1)] relative overflow-hidden">
        {project.image && (
          <button
            type="button"
            class="group block w-full border-b-2 sm:border-b-4 border-text bg-text/5 relative cursor-pointer"
            data-shots={JSON.stringify(setFor(project))}
            aria-label={project.trailer ? `Play the ${project.title} trailer` : `Open ${project.title} screenshots`}
          >
            <img
              src={project.image}
              alt={project.title}
              width="1200"
              height="900"
              loading="lazy"
              decoding="async"
              class="w-full h-40 sm:h-44 object-cover object-top"
            />
            <span class="absolute top-2 right-2 hidden sm:flex items-center border-2 border-text bg-white/90 px-2 py-1 opacity-0 group-hover:opacity-100 transition-opacity duration-150">
              <PixelIcon name={project.trailer ? 'play' : 'maximize'} className="w-3.5 h-3.5 text-text" />
            </span>
            {project.trailer && (
              <span class="absolute bottom-2 left-2 flex items-center gap-1.5 border-2 border-text bg-primary px-2 py-1">
                <PixelIcon name="play" className="w-3 h-3 text-text" />
                <span class="font-ubuntu-mono text-[10px] font-bold text-text uppercase tracking-wider">Trailer</span>
              </span>
            )}
          </button>
        )}

        <div class="flex flex-col gap-3 p-4 sm:p-5">
          <div class="flex items-start justify-between gap-2">
            <h4 class="font-black-han-sans text-text text-lg">{project.title}</h4>
            {project.repo && (
              <a
                href={project.repo}
                target="_blank"
                class="flex-shrink-0 text-text/60 hover:text-primary hover:scale-110 transition-all duration-150"
              >
                <PixelIcon name="link" className="w-4 h-4" />
              </a>
            )}
          </div>
          <p class="text-text font-open-sans text-sm leading-relaxed">
            {project.description}
          </p>
          <div class="flex flex-wrap gap-1.5">
            {project.tags.map((tag) => (
              <span class="text-text/70 bg-text/5 border border-text/20 px-2 py-0.5 text-xs font-ubuntu-mono">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  import { openViewer, originOf, type MediaItem } from "@/lib/crtViewer";

  function wire() {
    document.querySelectorAll<HTMLElement>("[data-shots]").forEach((button) => {
      if (button.dataset.wired) return;
      button.dataset.wired = "true";

      button.addEventListener("click", () => {
        let items: MediaItem[] = [];
        try {
          items = JSON.parse(button.dataset.shots || "[]");
        } catch {
          return;
        }
        if (!items.length) return;
        openViewer(items, 0, { origin: originOf(button) });
      });
    });
  }

  wire();
  document.addEventListener("astro:page-load", wire);
</script>
