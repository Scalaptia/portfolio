---
import PixelIcon from '@/components/PixelIcon';

type Props = {
  icon: import('@/components/PixelIcon').IconName | string;
  link: string;
  text: string;
};

const { icon, link, text }: Props = Astro.props;
---

<a
  href={link}
  class="press [--press:3px] sm:[--press:4px] w-full flex bg-text text-white px-4 sm:px-8 py-3 sm:py-4 items-center justify-center gap-3 sm:gap-4 border-2 border-white"
  target="_blank"
  rel="noopener noreferrer"
>
  <PixelIcon name={icon} className="w-5 h-5 sm:w-6 sm:h-6 flex-shrink-0" />
  <span class="font-black-han-sans text-lg sm:text-xl pt-[2px] whitespace-nowrap"
    >{text}</span
  >
</a>
