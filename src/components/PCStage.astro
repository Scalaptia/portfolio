---
import PCModel from "@/components/PCModel";
---

<!--
  The PC lives here, once, for every page. transition:persist carries the canvas node itself across
  navigations, so three.js loads a single time per visit and the model keeps its state instead of
  rebooting on every link.

  The canvas covers the window at all times and the model is flown around inside it. That is the
  whole trick: there is exactly one canvas layout, so moving from the hero to the corner to a
  full-window picture never resizes or rescales WebGL output, and never reflows the page.
-->
<div id="pc-backdrop" transition:persist="pc-backdrop" aria-hidden="true"></div>
<div id="pc-stage" transition:persist="pc-stage" data-viewing="false">
  <PCModel client:only="react" />
</div>

<style>
  #pc-stage {
    position: fixed;
    inset: 0;
    z-index: 40;
    /* The page underneath stays clickable; only the model's own hit area takes pointers. */
    pointer-events: none;
  }

  #pc-stage[data-viewing="true"] {
    z-index: 60;
  }

  #pc-backdrop {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: #08060a;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 320ms ease;
  }

  #pc-backdrop[data-on="true"] {
    opacity: 0.97;
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    #pc-backdrop {
      transition: none !important;
    }
  }
</style>

<script>
  // Placement lives with the model, in the canvas. All this has to do is dim the page behind it,
  // lift the stage above the header, and stop the page scrolling underneath the picture.
  let bound = false;

  function releaseScroll() {
    document.body.style.overflow = "";
  }

  function onViewerChange(event: Event) {
    const stage = document.getElementById("pc-stage");
    const backdrop = document.getElementById("pc-backdrop");
    const detail = (event as CustomEvent).detail as {
      open: boolean;
      mode: "crt" | "dom";
    };
    const showing = detail.open && detail.mode === "crt";

    if (stage) stage.dataset.viewing = showing ? "true" : "false";
    if (backdrop) backdrop.dataset.on = showing ? "true" : "false";
    if (showing) {
      document.body.style.overflow = "hidden";
    } else {
      releaseScroll();
    }
  }

  function init() {
    if (bound) return;
    bound = true;
    window.addEventListener("crtViewer", onViewerChange);
    // A navigation while the viewer is open must not leave the page unable to scroll.
    document.addEventListener("astro:before-swap", releaseScroll);
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
