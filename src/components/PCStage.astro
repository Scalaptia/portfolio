---
import PCModel from "@/components/PCModel";
---

<!--
  The PC lives here, once, for every page. transition:persist carries the canvas node itself across
  navigations, so three.js loads a single time per visit and the model keeps its state instead of
  rebooting on every link.
-->
<div
  id="pc-stage"
  transition:persist="pc-stage"
  data-state="corner"
  class="w-[200px] h-[200px] lg:w-[240px] lg:h-[240px]"
>
  <PCModel client:only="react" />
</div>

<style>
  #pc-stage {
    position: fixed;
    right: 2rem;
    bottom: 2rem;
    z-index: 40;
  }

  /* In the hero the stage is absolute, at the anchor's document coordinates, so it scrolls with
     the page without a single line of JavaScript running per frame. */
  #pc-stage[data-state="hero"] {
    position: absolute;
    right: auto;
    bottom: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    #pc-stage {
      transition: none !important;
    }
  }
</style>

<script>
  // Two resting places: the hero slot on the index page, and pinned to the bottom-right corner
  // everywhere else and once you scroll past the hero.
  const CORNER_AFTER = 400;
  const DESKTOP = "(min-width: 1024px)";
  const EASE = "transform 320ms cubic-bezier(0.22, 1, 0.36, 1)";

  type StageState = "hero" | "corner";

  let stage: HTMLElement | null = null;
  let anchor: HTMLElement | null = null;
  let anchorTop = 0;
  let anchorLeft = 0;
  let ticking = false;
  let bound = false;

  const reduceMotion = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function measureAnchor() {
    if (!anchor) return;
    const rect = anchor.getBoundingClientRect();
    anchorTop = rect.top + window.scrollY;
    anchorLeft = rect.left + window.scrollX;
  }

  function place(state: StageState) {
    if (!stage) return;
    stage.dataset.state = state;
    if (state === "hero") {
      stage.style.top = `${anchorTop}px`;
      stage.style.left = `${anchorLeft}px`;
    } else {
      stage.style.top = "";
      stage.style.left = "";
    }

    const hint = document.getElementById("click-me-text");
    if (hint) hint.style.opacity = state === "hero" ? "1" : "0";
  }

  // Move by translating only. Never scale: the canvas is WebGL output and scaling resamples it.
  function transitionTo(state: StageState) {
    if (!stage || stage.dataset.state === state) return;

    const first = stage.getBoundingClientRect();
    place(state);
    const last = stage.getBoundingClientRect();
    const dx = first.left - last.left;
    const dy = first.top - last.top;

    if (reduceMotion() || (dx === 0 && dy === 0)) return;

    stage.style.transition = "none";
    stage.style.transform = `translate3d(${dx}px, ${dy}px, 0)`;
    requestAnimationFrame(() => {
      if (!stage) return;
      stage.style.transition = EASE;
      stage.style.transform = "translate3d(0, 0, 0)";
    });
  }

  function update() {
    ticking = false;
    if (!stage) return;

    // No anchor means no hero on this page, so the corner is the only home.
    if (!anchor) {
      transitionTo("corner");
      return;
    }

    // On narrow screens the model stays in the hero and never follows you down the page.
    if (!window.matchMedia(DESKTOP).matches) {
      transitionTo("hero");
      return;
    }

    transitionTo(window.scrollY > CORNER_AFTER ? "corner" : "hero");
  }

  function requestUpdate() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(update);
  }

  function onResize() {
    measureAnchor();
    if (stage?.dataset.state === "hero") place("hero");
    requestUpdate();
  }

  function init() {
    stage = document.getElementById("pc-stage");
    anchor = document.getElementById("pc-hero-anchor");
    if (!stage) return;

    // Skip the slide on the first paint of a page.
    stage.style.transition = "none";
    measureAnchor();
    stage.dataset.state = anchor ? "hero" : "corner";
    place(stage.dataset.state as StageState);
    update();

    if (bound) return;
    bound = true;
    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", onResize);
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
