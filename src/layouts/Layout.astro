---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import BackgroundDecorations from "@/components/BackgroundDecorations.astro";
import Toast from "@/components/Toast";
import { ClientRouter } from "astro:transitions";

const { title, description } = Astro.props;
const { currentLocale } = Astro;

const SITE = "https://fharo.dev";
const lang = currentLocale === "es" ? "es" : "en";

// Every page passes a title. Fall back to the bare name for anything that does not.
const pageTitle = title ? `${title} | Fernando Haro` : "Fernando Haro";

const DEFAULT_DESCRIPTION = {
  en: "Fernando Haro, software engineer in Ensenada, Mexico. React, TypeScript and Node, with the projects and the code behind them.",
  es: "Fernando Haro, ingeniero de software en Ensenada, Mexico. React, TypeScript y Node, con los proyectos y el codigo detras de ellos.",
};
const pageDescription = description ?? DEFAULT_DESCRIPTION[lang];

// Both language versions of the current page, so crawlers stop reading them as duplicates.
const pathWithoutLang = Astro.url.pathname.replace(/^\/es(?=\/|$)/, "") || "/";
const enHref = new URL(pathWithoutLang, SITE).href;
const esHref = new URL(`/es${pathWithoutLang === "/" ? "/" : pathWithoutLang}`, SITE).href;
const canonical = lang === "es" ? esHref : enHref;
const ogImage = new URL("/og.png", SITE).href;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Fernando Haro Calvo",
  alternateName: "Fernando Haro",
  url: SITE,
  image: ogImage,
  jobTitle: "Software Engineer",
  email: "mailto:fernando.haro.c@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Ensenada",
    addressRegion: "Baja California",
    addressCountry: "MX",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Universidad Autonoma de Baja California",
  },
  knowsLanguage: ["es", "en"],
  sameAs: [
    "https://github.com/Scalaptia",
    "https://www.linkedin.com/in/haro-fernando/",
    "https://www.tech4goodresearchlab.com/projects/la-brujula-del-autismo",
  ],
};
---

<html lang={currentLocale} class="overflow-y-scroll">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- HTML Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="es" href={esHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />

    <!-- Facebook Meta Tags -->
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fernando Haro" />
    <meta property="og:locale" content={lang === "es" ? "es_MX" : "en_US"} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="fharo.dev" />
    <meta property="twitter:url" content={canonical} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />

    <!-- Umami Analytics -->
    <script
      defer
      src="https://umami.fharo.dev/script.js"
      data-website-id="73abe834-05b6-4a54-b407-5597a7b70e66"></script>

    <link rel="icon" href="/logo.ico" type="image/x-icon" />

    <!-- Archivo Black still comes from Google, because the file we shipped as
         archivo-black-v23-latin.woff2 was actually the latin-ext subset. Its cmap has no ASCII
         letters, so it never rendered a single character of a title and Google's copy was quietly
         doing all the work. It is now requested with display=block rather than swap, which is what
         made the header and the hero name jump once the web font arrived.
         Open Sans and Ubuntu Mono are ours and are preloaded. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=block" rel="stylesheet" />
    <link rel="preload" href="/fonts/open-sans-v40-latin-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ubuntu-mono-v17-latin-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts.css" />
    <ClientRouter />

    <style>
      :root {
        scrollbar-gutter: stable;
      }

      /* Prevent horizontal overflow */
      html,
      body {
        max-width: 100vw;
        overflow-x: hidden;
      }

      /* Add scroll margin for sections to account for fixed header */
      section[id],
      div[id] {
        scroll-margin-top: 120px; /* Adjust based on header height + padding */
      }

      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(30px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .animate-fade-in-up {
        animation: fadeInUp 0.8s ease-out forwards;
        opacity: 0;
      }

      /* View Transitions */
      ::view-transition-group(root) {
        animation-duration: 400ms;
        animation-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
      }

      ::view-transition-old(root) {
        animation: fade-out-smooth 400ms cubic-bezier(0.25, 0.1, 0.25, 1) both;
      }

      ::view-transition-new(root) {
        animation: fade-in-smooth 400ms cubic-bezier(0.25, 0.1, 0.25, 1) both;
      }

      @keyframes fade-out-smooth {
        from {
          opacity: 1;
          transform: scale(1);
        }
        to {
          opacity: 0;
          transform: scale(0.98);
        }
      }

      @keyframes fade-in-smooth {
        from {
          opacity: 0;
          transform: scale(0.98);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .animate-fade-in-up {
          animation: none;
          opacity: 1;
        }

        ::view-transition-group(*),
        ::view-transition-old(*),
        ::view-transition-new(*) {
          animation-duration: 1ms !important;
        }

        *,
        *::before,
        *::after {
          transition-duration: 0.01ms !important;
        }
      }


    </style>
  </head>
  <body
    class="min-h-screen flex flex-col items-center bg-background bg-noise bg-repeat overflow-x-hidden relative pt-16 sm:pt-20 w-full"
  >
    <BackgroundDecorations />
    <Header />
    <slot name="content" />
    <Footer />
    <Toast client:load />
  </body>
</html>
